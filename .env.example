# Cashmova Web — local dev environment variables
# Copy to .env.local for `npm run dev`.
#
# For Cloudflare deployment, these are NOT read from a file — set them as
# "Build variables" in the Cloudflare dashboard (Workers & Pages > your
# project > Settings > Variables), since Next.js inlines NEXT_PUBLIC_*
# values at BUILD time, not at request time. See the deployment guide.

# Your local backend, or your deployed Cloud Run URL
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# This app's own public URL
NEXT_PUBLIC_APP_URL=http://localhost:3001
