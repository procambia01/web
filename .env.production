# Used by `next build` (Cloudflare builds too). NEXT_PUBLIC_* are baked into the
# browser bundle at build time. Replace with your real LIVE backend URLs.
NEXT_PUBLIC_API_URL=https://api.cashmouver.com/api/v1
NEXT_PUBLIC_SOCKET_URL=https://api.cashmouver.com
NEXT_PUBLIC_APP_URL=https://cashmouver.com
API_URL=https://api.cashmouver.com/api/v1
